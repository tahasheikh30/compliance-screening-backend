# --- Database and sign in (required) -------------------------------------------------------------
# Supabase dashboard > Connect > "Session pooler". It works from hosts without IPv6 (Render's free plan).
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# https://<project-ref>.supabase.co : where sign in tokens are checked against the project's public keys
SUPABASE_URL=

# Only if the project signs tokens with the legacy shared secret (Project Settings > JWT Keys). Otherwise leave empty.
# SUPABASE_JWT_SECRET=

# The key the FRONTEND sends as X-API-Key on every request, next to the signed in person's token. Put the
# same value in the frontend as VITE_API_KEY. It is built into the frontend, so it only says "this request
# comes from the app" and is not a secret; the person's own sign in is what protects the data.
# Generate a strong random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=
# REQUIRE_APP_KEY=true          # false = do not check the app key (local development only)

# SECRET machine credential for the scheduled NACTA upload (X-API-Key, no sign in). It works on that one
# route only and must never be given to the frontend. Use a DIFFERENT value from APP_API_KEY.
API_KEY=

# CORS: comma-separated list of frontend origins allowed to call this API
# SUPABASE_SERVICE_ROLE_KEY=      # SECRET, backend only. Lets admins DELETE a person (People tab). Without it Delete is refused; Disable still works
ALLOWED_ORIGINS=http://localhost:5173

# Optional
# DB_POOL_MAX=8                 # connections kept open to the database

# Optional screening behaviour (defaults shown)
# MATCH_THRESHOLD=85            # default match threshold, 50..100; each request can override it
# LIST_CACHE_TTL_SECONDS=3600   # keep downloaded lists in memory this long; 0 = download fresh every screening
# PRELOAD_LISTS=true            # load every list at startup and reload it shortly before it expires, so screenings never wait for a download
# FIA_REQUIRED=true             # false = an unreachable FIA Red Book does not block AUTO_CLEAR (the n8n workflow's behaviour)

# NACTA Proscribed Persons: an admin uploads the exported list on the Lists page (or POST /api/admin/nacta),
# or the scheduled workflow does it. It is stored in the database.
# PEP_WIKIDATA=true             # fetch national and provincial office holders from Wikidata (false = your own uploaded list only)
# PEP_ASSEMBLIES=true           # also read the member lists of the National Assembly, Senate and provincial assemblies
# PEP_REFRESH_DAYS=7            # how often the Wikidata copy is refreshed (in the background)
# PEP_LOOKBACK_YEARS=5          # keep people who left office within this many years (0 = current only, negative = never drop)
# PEP_REQUIRED=false            # true = no PEP data at all sends an otherwise clear applicant to manual review
# NACTA_REQUIRED=true           # false = a missing or out of date NACTA list does not block AUTO_CLEAR
# NACTA_MAX_AGE_DAYS=30         # an uploaded copy older than this is reported as out of date
# NACTA_PERSONS_URL=            # optional: an address that serves the list as a plain JSON/XML/CSV file (your own copy or a proxy).
#                               # NACTA's own site has no such address (it is a Blazor Server app): use scripts/fetch_nacta.py
#                               # or upload the file. A saved last good copy is the fallback if this address fails

# No API keys are needed for the screening itself: every list is downloaded
# from its public publisher.

# --- Matching and safety (defaults shown) -------------------------------------------------------------
# NAME_VARIANTS=true            # fold well known spelling variants (MOHAMMED/MUHAMMAD/MOHD, SYED/SAYYID ...) before
#                               # scoring. false = the raw spellings, exactly as the original n8n workflow scored them
# MAX_DOWNLOAD_MB=120           # refuse any list download larger than this
# ENABLE_DOCS=false             # true exposes /docs, /redoc and /openapi.json (local development only)

# --- Continuous monitoring ---------------------------------------------------------------------------------
# MONITORING=true               # false switches the background check off (an admin can still run it by hand)
# MONITOR_INTERVAL_SECONDS=86400 # how often to look for list changes (60 or more)
# MONITOR_WEBHOOK_URL=          # optional https address told when new alerts appear (ids only, never a name)
# MONITOR_WEBHOOK_SECRET=       # optional: signs the webhook body, X-Signature: sha256=<hmac>

# --- Batch screening ---------------------------------------------------------------------------------------
# BATCH_MAX_ROWS=500            # applicants per uploaded file
# BATCH_MAX_FILE_MB=10          # size of an uploaded file
# BATCH_MAX_RUNNING=2           # batches running at once on each server (each screens its rows one by one)
# BATCH_STALE_SECONDS=300       # a running batch with no heartbeat for this long lost its server (30 or more; longer than the slowest row)
# BATCH_ROW_DELAY_SECONDS=0.5   # pause between rows, so a long file does not hammer the news search
