# Required — the app refuses to serve protected endpoints (503) without this.
# Generate a strong random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# CORS — comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Optional — adverse media screening (see README for the priority order)
# ADVERSE_MEDIA_API_KEY=
# ADVERSE_MEDIA_ENDPOINT=
# ANTHROPIC_API_KEY=

# Optional — only needed if you deploy with a persistent disk (see render.yaml)
# STORAGE_DIR=
