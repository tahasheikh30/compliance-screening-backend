# Required: the app refuses to serve protected endpoints (503) without this.
# Generate a strong random value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# CORS: comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Optional: where the SQLite DB and evidence PDFs are stored. Set this to the
# persistent disk's mount path when deploying (see render.yaml).
# STORAGE_DIR=

# Optional screening behaviour (defaults shown)
# MATCH_THRESHOLD=85            # default match threshold, 50..100; each request can override it
# LIST_CACHE_TTL_SECONDS=3600   # keep downloaded lists in memory this long; 0 = download fresh every screening
# PRELOAD_LISTS=true           # load every list at startup and reload it shortly before it expires, so screenings never wait for a download
# FIA_REQUIRED=true             # false = an unreachable FIA Red Book does not block AUTO_CLEAR (the n8n workflow's behaviour)

# NACTA Proscribed Persons: upload the exported list on the Lists page (or POST /api/admin/nacta).
# NACTA_REQUIRED=true           # false = a missing or out of date NACTA list does not block AUTO_CLEAR
# NACTA_MAX_AGE_DAYS=30         # an uploaded copy older than this is reported as out of date
# NACTA_PERSONS_URL=            # optional: an address that serves the list as a plain JSON/XML/CSV file (your own copy or a proxy).
#                               # NACTA's own site has no such address (it is a Blazor Server app): use scripts/fetch_nacta.py
#                               # or upload the file. A saved last good copy is the fallback if this address fails

# No API keys are needed for the screening itself: every list is downloaded
# from its public publisher.
